# Copy to .env.local and fill from Supabase → Project Settings → API
# Region tip: choose EU (e.g. Ireland / Frankfurt) for DoseRX

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Keep false for Try now / demos (localStorage only — no DB writes or photo uploads).
# Set true only when you go live.
VITE_SUPABASE_SYNC_ENABLED=false
